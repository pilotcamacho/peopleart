# Claude Code local settings
.claude/settings.local.json

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
/amplify/node_modules/

# ── Next.js ───────────────────────────────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*
.env*.local

# ── Amplify Gen 2 ─────────────────────────────────────────────────────────────
# amplify_outputs.json is intentionally NOT ignored.
# It contains only public identifiers (User Pool ID, AppSync endpoint, etc.) —
# no secrets. It must be committed so Vercel builds can read it.
# Per-file compiled JS — generated by postinstall (esbuild), never commit.
amplify/**/*.mjs
# CDK synthesis output — regenerated on each deploy.
.amplify/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Debug logs ────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Deployment platforms ──────────────────────────────────────────────────────
.vercel
